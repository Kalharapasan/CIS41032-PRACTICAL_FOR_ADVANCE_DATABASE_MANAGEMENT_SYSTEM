// 2. Show all supplies in the "Accessories" material type
db.factorySupplies.find({
  MaterialType: "Accessories"
})

// 3. Calculate total cost (Units × Price) of supplies per material
db.factorySupplies.aggregate([
    {
  $group: {
    _id: "$Material",
    TotalCost: {
      $sum: {
        $multiply: [
                        "$UnitsSupplied",
                        "$UnitPrice"
                    ]
                }
            }
        }
    }
])

// 4. Group by SupplierName and find total units supplied
db.factorySupplies.aggregate([
    {
  $group: {
    _id: "$SupplierName",
    TotalUnits: { $sum: "$UnitsSupplied"
            }
        }
    }
])

// 5. Find average unit price for each material type
db.factorySupplies.aggregate([
    {
  $group: {
    _id: "$MaterialType",
    AveragePrice: { $avg: "$UnitPrice"
            }
        }
    }
])

// 6. List top 2 materials with highest total cost
db.factorySupplies.aggregate([
    {
  $group: {
    _id: "$Material",
    TotalCost: {
      $sum: {
        $multiply: [
                        "$UnitsSupplied",
                        "$UnitPrice"
                    ]
                }
            }
        }
    },
    {
  $sort: { TotalCost: -1
        }
    },
    {
  $limit: 2
    }
])

// 7. Count number of different materials supplied by each supplier
db.factorySupplies.aggregate([
    {
  $group: {
    _id: "$SupplierName",
    Materials: { $addToSet: "$Material"
            }
        }
    },
    {
  $project: {
    NumberOfMaterials: { $size: "$Materials"
            }
        }
    }
])

// 8. Show all supply records between Jan 20 and Feb 20, 2023
db.factorySupplies.find({
  SupplyDate: {
    $gte: new Date("2023-01-20"),
    $lte: new Date("2023-02-20")
    }
})

// 9. Group by MaterialType and find max and min unit prices
db.factorySupplies.aggregate([
    {
  $group: {
    _id: "$MaterialType",
    MaxPrice: { $max: "$UnitPrice"
            },
    MinPrice: { $min: "$UnitPrice"
            }
        }
    }
])

// 10. Calculate total cost per supplier and sort descending
db.factorySupplies.aggregate([
    {
  $group: {
    _id: "$SupplierName",
    TotalCost: {
      $sum: {
        $multiply: [
                        "$UnitsSupplied",
                        "$UnitPrice"
                    ]
                }
            }
        }
    },
    {
  $sort: { TotalCost: -1
        }
    }
])

// 11. Output all "Fabric" supplies into new collection "fabricSupplies"
db.factorySupplies.aggregate([
    {
  $match: {
    MaterialType: "Fabric"
        }
    },
    {
  $out: "fabricSupplies"
    }
])