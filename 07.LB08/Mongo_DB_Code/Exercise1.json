// 2. Show all orders in the "Tops" category
db.garmentOrders.find({ Category: "Tops" })

// 3. Calculate total revenue from each category
db.garmentOrders.aggregate([
{
  $group: {
    _id: "$Category",
    TotalRevenue: {
      $sum: { $multiply: ["$Quantity", "$Price"] }
    }
  }
}
])

// 4. Find the highest quantity of any product ordered
db.garmentOrders.aggregate([
{
  $group: {
    _id: null,
    HighestQuantity: { $max: "$Quantity" }
  }
}
])

// 5. Calculate total amount spent by each customer
db.garmentOrders.aggregate([
{
  $group: {
    _id: "$CustomerName",
    TotalSpent: {
      $sum: { $multiply: ["$Quantity", "$Price"] }
    }
  }
}
])

// 6. Show average price of products in each category
db.garmentOrders.aggregate([
{
  $group: {
    _id: "$Category",
    AveragePrice: { $avg: "$Price" }
  }
}
])

// 7. Group by category and count how many products were sold
db.garmentOrders.aggregate([
{
  $group: {
    _id: "$Category",
    TotalProductsSold: { $sum: "$Quantity" }
  }
}
])

// 8. Sort customers by total amount spent in descending order
db.garmentOrders.aggregate([
{
  $group: {
    _id: "$CustomerName",
    TotalSpent: {
      $sum: { $multiply: ["$Quantity", "$Price"] }
    }
  }
},
{
  $sort: { TotalSpent: -1 }
}
])

// 9. Find all orders placed after February 1, 2023
db.garmentOrders.find({
  OrderDate: { $gt: new Date("2023-02-01") }
})

// 10. Group products by category and find maximum price
db.garmentOrders.aggregate([
{
  $group: {
    _id: "$Category",
    MaxPrice: { $max: "$Price" }
  }
}
])

// 11. Save all "Outerwear" orders to new collection "outerwearOrders"
db.garmentOrders.aggregate([
{
  $match: { Category: "Outerwear" }
},
{
  $out: "outerwearOrders"
}
])